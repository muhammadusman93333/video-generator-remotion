AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_VOICE=en-IN-NeerjaNeural
PORT=3000
# Public URL Make.com can reach (ngrok / your domain). No trailing slash.
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Speed up local rendering by using multi-core/auto concurrency (e.g. auto, or 8) and enabling GPU
# REMOTION_CONCURRENCY=auto
# REMOTION_BROWSER_FLAGS=--disable-dev-shm-usage
